# ===================================================
# VIRALCUT AI — Environment Configuration Example
# Copy this file to .env and fill in your values.
# NEVER commit .env to GitHub or share secrets publicly.
# ===================================================

# Server Environment
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Authentication & Security (generate with: openssl rand -hex 32)
SECRET_KEY=replace_with_a_super_secret_64_char_key_for_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
OWNER_EMAIL=admin@viralcut.ai
OWNER_PASSWORD=adminpassword123

# Official Google GenAI SDK (Get free key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Database (defaults to local SQLite for instant local dev, use PostgreSQL for Render)
# Local: sqlite+aiosqlite:///./viralcut.db
# Cloud: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=sqlite+aiosqlite:///./viralcut.db

# Task Queue (defaults to local in-process queue, use Redis for Render)
# Local: memory:// or redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# Storage (local filesystem for dev, S3 / Cloudflare R2 / AWS for production)
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./storage
STORAGE_ENDPOINT=
STORAGE_BUCKET=viralcut-clips
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=us-east-1

# Video Processing Limits
MAX_UPLOAD_SIZE_MB=500
MAX_VIDEO_DURATION_SECONDS=3600
DEFAULT_EXPORT_RESOLUTION=4K
DEFAULT_EXPORT_CRF=18
DEFAULT_EXPORT_CODEC=libx264
